# Sanity — from https://www.sanity.io/manage after creating a project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-07

# Viewer-scoped read token. Server-only: it must never be exposed to the browser,
# so do not prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Optional. Set this and point a Sanity webhook at POST /api/revalidate to make a
# publish clear the page cache straight away; without it published content is picked
# up within a minute instead. Must match the secret configured on the webhook.
SANITY_REVALIDATE_SECRET=

# Optional. The site's public origin, used for share-card images, canonical links,
# hreflang and the sitemap — all of which are read by machines that cannot infer it
# from the request. Vercel supplies its own production domain automatically, so this
# is only needed for a custom domain or to make `next dev` produce real URLs.
NEXT_PUBLIC_SITE_URL=
